        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/TokenResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/waves" : {
      "get" : {
        "tags" : [ "Wave authoring" ],
        "summary" : "List every wave, drafts included",
