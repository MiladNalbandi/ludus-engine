        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/TokenResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/refresh" : {
      "post" : {
        "tags" : [ "Authentication" ],
        "summary" : "Exchange a refresh token for a new pair",
        "description" : "The presented token is revoked as part of the exchange, so a stolen token and the real one cannot both keep working.",
