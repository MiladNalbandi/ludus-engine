      "post" : {
        "tags" : [ "Public content" ],
        "summary" : "Several published documents at once",
        "description" : "For a first launch, when a client has nothing cached. Unknown or unpublished ids are simply absent. Not cacheable; revalidate with the single document routes.",
        "operationId" : "batchGetPublishedWaves",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/BatchRequest"
