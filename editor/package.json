{
  "name": "ludus-editor",
  "version": "0.3.0",
  "private": true,
  "description": "The visual editor for Ludus. Talks to the engine over its public HTTP API and holds no content of its own.",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint src scripts --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:types": "tsx scripts/generate-types.ts",
    "verify:types": "tsx scripts/generate-types.ts --check"
  },
  "dependencies": {
    "next": "15.5.25",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.25",
    "jsdom": "30.0.1",
    "json-schema-to-typescript": "16.0.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
