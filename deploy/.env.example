# Copy to deploy/.env and change the password. Nothing here is a real credential.

# --- Database ---------------------------------------------------------------
LUDUS_DB_NAME=ludus
LUDUS_DB_USER=ludus
# Required. Compose refuses to start without it, on purpose.
LUDUS_DB_PASSWORD=change-me-before-first-run

# --- Server -----------------------------------------------------------------
# Published on 127.0.0.1 only. See docs/operations/configuration.md before exposing it.
LUDUS_PORT=8080
LUDUS_LOG_LEVEL=INFO

# --- Image ------------------------------------------------------------------
# Pin to a release tag in production rather than tracking latest.
LUDUS_VERSION=latest
