# Copy to deploy/.env, set the three required values, and leave the rest alone until you need
# them. Nothing here is a real credential.
#
# Two kinds of line live in this file. WAVEMAKER_DB_*, WAVEMAKER_PORT, WAVEMAKER_EDITOR_PORT,
# WAVEMAKER_VERSION and WAVEMAKER_WITH_FFMPEG are read by docker compose to build the stack.
# Every other WAVEMAKER_* line is handed to the service exactly as written, so a setting you
# do not want must be commented out rather than left empty: the service reads an empty value
# as a value, and an empty path is a path.

# --- Database (read by compose) ---------------------------------------------------------------
WAVEMAKER_DB_NAME=wavemaker
WAVEMAKER_DB_USER=wavemaker
# Required. Compose refuses to start without it, on purpose. It is put into a database URL, so
# avoid '@', ':', '/', '?', '#' and '%'; `openssl rand -hex 24` makes one that is safe.
WAVEMAKER_DB_PASSWORD=change-me-before-first-run

# --- Ports and image (read by compose) --------------------------------------------------------
# Both published on 127.0.0.1 only. See docs/operations/deployment.md before exposing either.
WAVEMAKER_PORT=8080
WAVEMAKER_EDITOR_PORT=3000
# Pin to a release tag in production rather than tracking latest.
WAVEMAKER_VERSION=latest
# true builds the service image with FFmpeg in it, which audio mixing needs. Set
# WAVEMAKER_MEDIA_FFMPEG_BINARY below as well, or the image carries FFmpeg and nothing uses it.
WAVEMAKER_WITH_FFMPEG=false

# --- Security ---------------------------------------------------------------------------------
# Required. There is no default and there will not be one: a signing secret published in a
# public repository lets anyone forge a token for every install that kept it. Generate one:
#
#     openssl rand -base64 48
#
# The service refuses to start without it, and refuses anything shorter than 32 bytes.
WAVEMAKER_JWT_SECRET=

# How long each kind of token lives. An access token is short because it cannot be revoked; a
# player token is short because it lives on a device anybody can unpack.
#WAVEMAKER_ACCESS_TOKEN_MINUTES=15
#WAVEMAKER_REFRESH_TOKEN_DAYS=30
#WAVEMAKER_PLAYER_TOKEN_MINUTES=60

# An administrator, created at startup when no account with this email exists yet, and left
# alone when one does: changing the password here never resets an existing account's, and
# clearing both deletes nobody. A different email creates a second administrator.
WAVEMAKER_ADMIN_EMAIL=
WAVEMAKER_ADMIN_PASSWORD=

# --- Project ----------------------------------------------------------------------------------
# The one project a self-hosted install serves, provisioned at startup.
#WAVEMAKER_PROJECT_SLUG=default
#WAVEMAKER_PROJECT_NAME=Default

# --- Plugins ----------------------------------------------------------------------------------
# Where `wavemaker plugin install` finds packages: a directory holding index.json and the
# archives it lists, as the container sees it. Read only by the install command.
#WAVEMAKER_PLUGIN_REGISTRY=/srv/registry
# The public keys a plugin may be signed with, one PEM file per key, as the container sees
# them. Unset trusts nobody, so nothing can be installed until somebody decides whose
# signature counts.
#WAVEMAKER_TRUSTED_KEYS_DIRECTORY=/srv/trusted-keys

# --- Media ------------------------------------------------------------------------------------
# Uploads larger than these are refused, in bytes. 64 MiB of audio and 16 MiB per sprite.
#WAVEMAKER_MEDIA_MAX_AUDIO_BYTES=67108864
#WAVEMAKER_MEDIA_MAX_SPRITE_BYTES=16777216
# Mixing several clips into one needs FFmpeg, which the standard image deliberately does not
# carry. Build with WAVEMAKER_WITH_FFMPEG=true above and set this to /usr/bin/ffmpeg. Unset,
# the mix route answers 503 and everything else about audio works.
#WAVEMAKER_MEDIA_FFMPEG_BINARY=/usr/bin/ffmpeg
# A hard stop on one mix, and caps on what it may take and produce.
#WAVEMAKER_MEDIA_MIX_TIMEOUT_SECONDS=60
#WAVEMAKER_MEDIA_MIX_MAX_TRACKS=8
#WAVEMAKER_MEDIA_MIX_MAX_OUTPUT_BYTES=67108864

# --- Set by compose and the image, listed so nothing the service reads is a surprise ---------
# WAVEMAKER_DATABASE_URL       built by compose from the database settings above
# WAVEMAKER_BLOB_DIRECTORY     /var/lib/wavemaker/blobs, the wavemaker-blobs volume
# WAVEMAKER_PLUGINS_DIRECTORY  /var/lib/wavemaker/plugins, the wavemaker-plugins volume
# WAVEMAKER_WAVE_SCHEMA        /app/contracts/schemas/wave/v1.json, inside the image

# --- Editor -----------------------------------------------------------------------------------
# The editor's own setting, under the name the editor reads. Set it to true when the editor is
# served over HTTPS. It makes the refresh cookie Secure, which a browser then refuses to send
# over plain HTTP -- correct in production, and an immediate "why am I logged out" on localhost.
LUDUS_EDITOR_HTTPS=false
