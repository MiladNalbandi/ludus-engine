# Copy to deploy/.env and change the password. Nothing here is a real credential.

# --- Database ---------------------------------------------------------------
LUDUS_DB_NAME=ludus
LUDUS_DB_USER=ludus
# Required. Compose refuses to start without it, on purpose.
LUDUS_DB_PASSWORD=change-me-before-first-run

# --- Server -----------------------------------------------------------------
# Published on 127.0.0.1 only. See docs/operations/configuration.md before exposing it.
LUDUS_PORT=8080
LUDUS_LOG_LEVEL=INFO

# --- Security ---------------------------------------------------------------
# Required. There is no default and there will not be one: a signing secret published in a
# public repository lets anyone forge a token for every install that kept it. Generate one:
#
#     openssl rand -base64 48
#
# The engine refuses to start without it, and refuses anything shorter than 32 bytes.
LUDUS_JWT_SECRET=

# The first administrator, created only into a project that has no users yet. After that this
# does nothing: changing it will not reset an existing administrator's password, and clearing
# it will not delete the account.
LUDUS_ADMIN_EMAIL=
LUDUS_ADMIN_PASSWORD=

# --- Tenancy ----------------------------------------------------------------
# 'single' resolves every request to the one seeded project and is what a self-hosted install
# wants. 'multi' is accepted and provisions nothing; the hosted deployment is v2.0.0.
LUDUS_TENANCY_MODE=single

# --- Audio ------------------------------------------------------------------
# Clip bytes are written to a docker volume, not the database. Compose mounts that volume and
# sets LUDUS_AUDIO_DIRECTORY itself; you only need to set it if you run the engine another way.
# Uploads larger than this are refused; raise it if your music tracks are longer than a few
# minutes.
LUDUS_AUDIO_MAX_FILE_SIZE=64MB

# --- Image ------------------------------------------------------------------
# Pin to a release tag in production rather than tracking latest.
LUDUS_VERSION=latest
